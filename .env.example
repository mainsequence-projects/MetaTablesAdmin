# This value is read by Vite's development server, not exposed to browser code.
METATABLES_API_TARGET=http://127.0.0.1:18473

# This project's VS Code launch configuration supplies METATABLES_LOCAL_TOKEN
# to the Vite server process. Do not configure it in this file.
# Never prefix the token with VITE_.

# Command Center's platform injects VITE_COMMAND_CENTER_ORIGIN for Vite builds.
# It is platform-reserved: do not add it to the release's build environment.
# The API release binding is public deployment identity, not a credential.
# Local development does not use it. Once the MetaTables API release exists:
# VITE_METATABLES_RESOURCE_RELEASE_UID=<release-uid>

# The MetaTables Analyst assistant. The deployed site's build names the Analyst and
# its Environment; both are public identities, not credentials. Without them the
# site shows no assistant.
# VITE_METATABLES_AGENT_UID=<the Analyst's Agent UID in this Environment>
# VITE_METATABLES_ENVIRONMENT_UID=<the Organization Environment UID>
# On a local top-level page, put one of these in .env.development.local instead:
# VITE_METATABLES_ASSISTANT_SOURCE=local  (an ms-tau Agent on 127.0.0.1:8787)
# or open the page with ?stand-in to use Command Center AI's scripted stand-in.
