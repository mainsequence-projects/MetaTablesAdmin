# This value is read by Vite's development server, not exposed to browser code.
METATABLES_API_TARGET=http://127.0.0.1:8001

# This project's VS Code launch configuration supplies METATABLES_LOCAL_TOKEN
# to the Vite server process. Do not configure it in this file.
# Never prefix the token with VITE_.

# Required for a deployed site embedded by Command Center. The host origin is
# validated by the SDK iframe handshake. The release UID identifies MetaTables API.
# VITE_COMMAND_CENTER_ORIGIN=https://command-center.example.com
# VITE_METATABLES_RESOURCE_RELEASE_UID=<release-uid>
