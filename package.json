{
  "name": "metatablesadmin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "tsc -b && npm test && npm run theme:audit",
    "test": "node --test tests/apiContract.test.mjs tests/apiRequests.test.mjs tests/inFlightReads.test.mjs tests/sourceConfiguration.test.mjs tests/permissionSelection.test.mjs tests/runtimeMigrationStatus.test.mjs tests/detailTabs.test.mjs tests/sdkBoundary.test.mjs tests/updatePipeline.test.mjs tests/ulm.test.mjs",
    "test:proxy": "node --test tests/proxy.test.mjs",
    "check:sdk": "node --test tests/sdkBoundary.test.mjs",
    "theme:audit": "command-center-sdk theme audit --path src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dev-mainsequence/command-center-sdk": "^0.5.8",
    "@xyflow/react": "12.11.6",
    "lucide-react": "^0.500.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.1.5"
  }
}
